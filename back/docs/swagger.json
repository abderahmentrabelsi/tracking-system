                },
                "totalConversions": {
                    "type": "integer"
                },
                "totalEventCount": {
                    "type": "integer"
                },
                "totalNewUsers": {
                    "type": "integer"
                },
                "totalRevenue": {
                    "type": "number"
                },
                "totalScreenPageViews": {
                    "type": "integer"
                },
