    "paths": {
        "/analytics": {
            "get": {
                "description": "Get analytics data from Google Analytics",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analytics"
                ],
                "summary": "Get Analytics Data",
                "responses": {
                    "200": {
                        "description": "OK",
